[sub_resource type="Shader" id="Shader_aura"]
code = "// Desenha a silhueta do sprite com uma cor so, somando luz (efeito de brilho).
shader_type canvas_item;
render_mode blend_add;

uniform vec4 aura_color : source_color = vec4(0.45, 0.8, 1.0, 0.45);

void fragment() {
	float alpha = texture(TEXTURE, UV).a;
	COLOR = vec4(aura_color.rgb, alpha * aura_color.a);
}
"

